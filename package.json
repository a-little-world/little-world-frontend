{
  "name": "littleplanet",
  "version": "0.1.316",
  "private": true,
  "scripts": {
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "lint-fix": "pnpm run lint --fix",
    "format:check": "prettier --check ./src",
    "format:fix": "prettier --write ./src",
    "dev": "webpack serveviews/index.js --env DEV_TOOL=eval-cheap-module-source-map --env DEBUG=1 --mode development",
    "clean": "rimraf dist",
    "build": "pnpm run clean && pnpm run build:bundle && pnpm run build:types && pnpm run copy-files:esm && pnpm run copy-files:cjs && pnpm pack",
    "build:bundle": "rollup --config rollup.config.mjs",
    "build:types": "tsc --project tsconfig.json --noCheck --emitDeclarationOnly --outDir dist/esm",
    "copy-files:esm": "node scripts/copy-assets.mjs esm",
    "copy-files:cjs": "node scripts/copy-assets.mjs cjs",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": "@a-little-world/little-world-prettier-config",
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "@a-little-world/little-world-design-system": "^3.1.2",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@firebase/app": "^0.14.13",
    "@firebase/messaging": "^0.12.26",
    "@livekit/components-react": "file:prebuild/livekit-components-react-2.9.21.tgz",
    "@livekit/components-styles": "file:prebuild/livekit-components-styles-1.2.1.tgz",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@reduxjs/toolkit": "^2.12.0",
    "@remix-run/router": "^1.23.4",
    "@types/node": "^18.19.130",
    "@types/react": "19.2.4",
    "babel-loader": "^9.2.1",
    "babel-plugin-styled-components": "^2.3.0",
    "classnames": "^2.5.1",
    "date-fns": "^3.6.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-cookie": "^3.0.8",
    "livekit-client": "^2.22.2",
    "lodash": "^4.18.1",
    "lodash.throttle": "^4.1.1",
    "moment": "^2.30.1",
    "motion": "^12.43.0",
    "process": "^0.11.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^14.1.3",
    "react-nice-avatar": "file:prebuild/react-nice-avatar-1.6.1.tgz",
    "react-router-dom": "^6.30.6",
    "react-use-websocket": "^4.13.0",
    "style-loader": "^3.3.4",
    "styled-components": "^6.5.3",
    "swr": "^2.5.1",
    "util": "^0.12.5",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "web-vitals": "^2.1.4",
    "webpack": "^5.110.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@a-little-world/little-world-prettier-config": "^2.0.0",
    "@changesets/cli": "^2.31.1",
    "@firebase/app-types": "^0.9.6",
    "@firebase/messaging-types": "^0.6.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@svgr/webpack": "^6.5.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.25",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "compression-webpack-plugin": "^12.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.8",
    "prettier": "3.8.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-bundle-tracker": "^1.8.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  },
  "overrides": {
    "react-scripts": {
      "typescript": "^5"
    }
  }
}